OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# elevenlabs
TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_USD_PER_1K_CHARS=
# voice_settings (0~1). 비우면 기본값 0.5 / 0.75
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
# 1이면 원본 mp3와 원본 기준 글자 시각(scene_XX.align.json)을 assets/audio에 남긴다 (숨소리 자르기 실험용)
KEEP_RAW_TTS=0

# 아래 경로는 프로젝트 루트(whiteboard-shorts/) 기준
JOBS_DIR=./jobs
WHITEBOARD_ANIMATOR_DIR=./vendor/whiteboard-animator
REMOTION_DIR=./remotion

IMAGE_GRAYSCALE=1
IMAGE_WHITE_THRESHOLD=235
FACT_CHECK=1
FACT_CHECK_EFFORT=low