OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# elevenlabs
# elevenlabs(기본) | edge(무료, 키 없음) | silent(음성 없이 무음 — 흐름 확인용)
TTS_ENGINE=elevenlabs
# TTS_ENGINE=edge일 때 목소리·속도 (남성: ko-KR-InJoonNeural)
# EDGE_VOICE=ko-KR-SunHiNeural
# EDGE_RATE=+8%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_USD_PER_1K_CHARS=

# 아래 경로는 프로젝트 루트(whiteboard-shorts/) 기준
JOBS_DIR=./jobs
WHITEBOARD_ANIMATOR_DIR=./vendor/whiteboard-animator
REMOTION_DIR=./remotion

IMAGE_GRAYSCALE=1
IMAGE_WHITE_THRESHOLD=235
FACT_CHECK=1
FACT_CHECK_EFFORT=low
# ---------- 화면 배치 · 자막 · 제목 (선택, 비우면 기본값) ----------
# 자막: 폰트(CSS font-family), 크기(px), 굵기, 색, 화면 아래에서 띄울 거리(px, 쇼츠 재생바 위)
# SUBTITLE_FONT='Noto Sans KR', sans-serif
# SUBTITLE_SIZE=56
# SUBTITLE_WEIGHT=800
# SUBTITLE_COLOR=#111111
# SUBTITLE_BOTTOM=400
# 상단 제목: 끄려면 TITLE_SHOW=0. 폰트를 비우면 자막 폰트와 같음
# TITLE_SHOW=1
# TITLE_FONT=
# TITLE_SIZE=80
# TITLE_COLOR=#111111
# TITLE_TOP=150
# 그림 크기·위치(px, 1080x1920 안)
# IMAGE_HEIGHT=1000
# IMAGE_TOP=360
